# auto | anthropic | openai | mock   (auto = first provider with a key, otherwise offline mock)
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# any OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# OpenAI only (the anthropic SDK 1.x Messages API has no temperature parameter)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
# total attempts per LLM stage (1 initial + retries with a repair prompt)
AGENT_MAX_ATTEMPTS=3
LOG_LEVEL=WARNING
